# Required security
APP_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Airtable access (required for private views; public shared-view CSV may work without it)
AIRTABLE_TOKEN=

# DoubleTick Public API (required to create templates and refresh approval status)
DOUBLETICK_API_KEY=
DOUBLETICK_WABA_NUMBER=
DOUBLETICK_WEBHOOK_SECRET=

# Existing DoubleTick proxy integration from the supplied reference ZIP
DOUBLETICK_PROXY_URL=
DOUBLETICK_PROXY_TOKEN=
DOUBLETICK_SENDER_NUMBER=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Comma-separated placeholder order configured for your approved template
WHATSAPP_TEMPLATE_VARIABLES=name,specialization,city,state
MAX_MESSAGES_PER_RUN=1000
REQUEST_TIMEOUT_SECONDS=30

# Leave DATABASE_URL empty for local SQLite. Set it to a PostgreSQL connection URL to use PostgreSQL.
DATABASE_URL=
DATABASE_PATH=./data/app.db

# Airtable candidate cache duration (seconds); default 300 = 5 minutes
AIRTABLE_CACHE_TTL_SECONDS=300
